+# MeCab's sources still use the `register` storage class, which C++17 removed.
+# This built fine while the app pinned NDK 21 (clang defaulted to C++14); the
+# current NDK defaults to C++17 and rejects it outright. Compile MeCab as C++14
+# rather than editing its sources -- it is upstream C code we do not want to
+# fork -- and silence the keyword warning for the same reason.
+set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+add_compile_options(-Wno-register)
+
 add_library( mecab_dart
 
